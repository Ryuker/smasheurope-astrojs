### Get all events
GET http://localhost:5001/api/events

### Get Event by ID
GET http://localhost:5001/api/events/fc11


### Post new event
POST http://localhost:5001/api/events
Content-Type: application/json

{
  "banner": "Lennied2/lennied-2-se-banner.webp",
  "title": "Lennied: Fatta the Lan",
  "games": "Melee",
  "description": "Hosted in London's <a target=\"_blank\" href=\"https://www.redbull.com/gb-en/projects/gaming-sphere/\">Red Bull Gaming Sphere</a>, Lennied is back for another edition with regular competitions for Melee singles & doubles and Red Bull God's and Gatekeepers style crews. There's also a mystery game to compete in.",
  "dates": [
    "2026-10-03T00:00:00.000Z",
    "2026-10-04T20:00:00.000Z"
  ],
  "location": {
    "municipality": "London",
    "country": "England"
  },
  "details": "https://www.start.gg/lennied-fatta-the-lan/",
  "slug": "lennied-2"
}

### Post new event part of circuit
POST http://localhost:5001/api/events
Content-Type: application/json

{
  "banner": "SomnioNoctem2/somnio-noctem-2-se-banner.webp",
  "title": "Somnio Noctem 2",
  "games": "Melee | Ultimate | \"Brawl\" ",
  "description": "The Somnio team is bringing another Major to the <a target=\"_blank\" href=\"https://h20.gg/en/\">H20 Esports Campus</a> in Purmerend (near Amsterdam). There's singles, doubles and 3 vs 3 crew competitions for Melee and Ultimate along with several other games to compete in and exciting side events like a talent show 😶‍🌫️. There's no max capacity for this event.",
  "dates": [
    "2027-04-23T00:00:00.000Z",
    "2027-04-25T20:00:00.000Z"
  ],
  "location": {
    "municipality": "Purmerend",
    "country": "Netherlands"
  },
  "circuits": [
    {
      "slug": "cloud-chasers"
    }
  ],
  "details": "https://start.gg/somnio-noctem/",
  "slug": "somnio-noctem-2"
}

