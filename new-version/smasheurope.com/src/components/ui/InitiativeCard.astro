---
import { Image } from "astro:assets";

interface Props {
  title?: string;
  image: string | any;
  alt: string;
  columns?: number; // Pass whatever column count your layout expects
}

const { title, image, alt, columns } = Astro.props;

// 1. Keep your working default layout classes if no prop is provided
// 2. If 'columns' is passed, dynamically build the classes without breaking the structure
const totalGridClass = columns ? `lg:grid-cols-${columns}` : "lg:grid-cols-4";
const textSpanClass = columns ? `lg:col-span-${columns - 1}` : "lg:col-span-3";

// 3. Safely check if the passed image asset path ends in '.svg'
const imageSrc = typeof image === 'string' ? image : image?.src || '';
const isSvg = imageSrc.toLowerCase().endsWith('.svg') || imageSrc.includes('.svg?');

// 4. Conditionally remove object-none for SVGs, keep it for standard images
const imageClass = isSvg 
  ? "flex lg:basis-full items-center py-2 h-auto max-w-full" // Removed object-none, added auto-scaling for SVGs
  : "flex lg:basis-full items-center py-2 object-none"; // Original string preserved for normal images
---
<div class="flex justify-center bg-white mx-5 sm:mx-10 h-full rounded-lg p-8 shadow-md">
  {/* Using your exact original HTML structure */}
  <div class={`grid grid-cols-1 ${totalGridClass} lg:space-x-10`}>
    <div class="flex items-center justify-center">
      {/* Replaced fixed class string with dynamic imageClass */}
      <Image src={image} alt={alt} class={imageClass} />
    </div>
    <div class={`col-span-1 ${textSpanClass} space-y-2`}>
      <span class="text-2xl text-se-dark font-bold">{title}</span>
      <div class="text-se-muted text-m text-justify space-y-3">
        <slot name="content"/>
      </div>
      <div class="flex basis-full py-3">
        <slot name="buttons" />
      </div>
    </div>
  </div>
</div>
